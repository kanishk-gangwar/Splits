<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Splits" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch screen: the whole ring on the app's background. SplitsSplash then picks up from
         this exact frame and plays the split. -->
    <style name="Theme.Splits.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_ring</item>
        <item name="postSplashScreenTheme">@style/Theme.Splits</item>
    </style>
</resources>
